# Anki sync server settings (read by anki-syncserver.service)
# Install as /etc/anki-syncserver.env, owned by root, mode 600:
#   sudo install -o root -g root -m 600 anki-syncserver.env /etc/anki-syncserver.env
#
# Passwords are PHC-format pbkdf2-sha256 hashes, made with scripts/hash_password.py.
# Never commit the real file.
PASSWORDS_HASHED=1
SYNC_USER1=you@example.com:$pbkdf2-sha256$i=600000,l=32$<salt>$<hash>
SYNC_USER2=someone@example.com:$pbkdf2-sha256$i=600000,l=32$<salt>$<hash>
SYNC_BASE=/home/alex/.syncserver
SYNC_PORT=41641
MAX_SYNC_PAYLOAD_MEGS=2000
